# Public URL of the site (used for SEO: canonical links, sitemap, Open Graph).
# Optional on Vercel: the production domain is detected automatically.
NEXT_PUBLIC_SITE_URL=https://khujirt.vercel.app

# Postgres for the Python API (api/index.py). On Vercel this is set for you when a Neon
# database is connected to the project (Storage → Neon). Tables are created on the first request.
DATABASE_URL=

# Optional. Salt for hashing visitor IPs (default: derived from DATABASE_URL).
IP_HASH_SALT=

# Optional. Read products from another copy of the API instead of this site's own /api.
KHUJIRT_API_URL=
# Local development: where `python3 backend/dev_server.py` runs, so /api/* reaches it.
KHUJIRT_API_DEV_URL=http://127.0.0.1:8000
