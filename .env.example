# Public URL of the site (used for SEO: canonical links, sitemap, Open Graph).
# Optional on Vercel: the production domain is detected automatically.
NEXT_PUBLIC_SITE_URL=https://khujirt.vercel.app

# Database of the Python API (api/index.py): Cloudflare D1 `khujirt-db` over the D1 HTTP API.
# A Cloudflare API token with the Account · D1 · Edit permission.
CLOUDFLARE_API_TOKEN=
# Optional: found from the token when empty.
CLOUDFLARE_ACCOUNT_ID=
# Optional: defaults to khujirt-db (a748e6df-ddbf-4111-a723-f9c836cbf3e7).
D1_DATABASE_ID=

# Alternative to D1: Postgres (tables are created from backend/postgres on the first request).
DATABASE_URL=

# Optional. Salt for hashing visitor IPs (default: derived from the database credential).
IP_HASH_SALT=

# Optional. Read products from another copy of the API instead of this site's own /api.
KHUJIRT_API_URL=
# Local development: where `python3 backend/dev_server.py` runs, so /api/* reaches it.
KHUJIRT_API_DEV_URL=http://127.0.0.1:8000
