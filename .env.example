# Public URL of the site (used for SEO: canonical links, sitemap, Open Graph).
# Optional on Vercel: the production domain is detected automatically.
NEXT_PUBLIC_SITE_URL=https://khujirt.vercel.app

# URL of the Python API on Cloudflare Workers (backend/). Leave empty to use the built-in content.
KHUJIRT_API_URL=https://khujirt-api.<your-subdomain>.workers.dev

# Shared secret sent to the API so it can trust the visitor IP forwarded by the contact proxy.
# Must match the API_PROXY_KEY secret of the worker.
KHUJIRT_API_PROXY_KEY=
