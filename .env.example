# Public URL of the site (used for SEO: canonical links, sitemap, Open Graph).
# Optional on Vercel: the production domain is detected automatically.
NEXT_PUBLIC_SITE_URL=https://khujirt.vercel.app

# URL of the Python API on Cloudflare Workers (backend/). Optional: by default the address the
# deploy workflow recorded in lib/api-endpoint.json is used; with neither, the built-in content is shown.
KHUJIRT_API_URL=
# Same, for the contact form in the browser.
NEXT_PUBLIC_KHUJIRT_API_URL=

# Only if the worker has an API_PROXY_KEY secret and the form posts through /api/contact.
KHUJIRT_API_PROXY_KEY=
